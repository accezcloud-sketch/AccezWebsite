{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/pricing/property-managers/",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/pricing/property-managers/",
      "permanent": true
    },
    {
      "source": "/ar/pricing",
      "destination": "/ar/pricing/property-managers/",
      "permanent": true
    },
    {
      "source": "/ar/pricing/",
      "destination": "/ar/pricing/property-managers/",
      "permanent": true
    },
    {
      "source": "/modules",
      "destination": "/solutions/property-managers/",
      "permanent": true
    },
    {
      "source": "/modules/",
      "destination": "/solutions/property-managers/",
      "permanent": true
    },
    {
      "source": "/ar/modules",
      "destination": "/ar/solutions/property-managers/",
      "permanent": true
    },
    {
      "source": "/ar/modules/",
      "destination": "/ar/solutions/property-managers/",
      "permanent": true
    },
    {
      "source": "/service-providers",
      "destination": "/solutions/service-providers/",
      "permanent": true
    },
    {
      "source": "/service-providers/",
      "destination": "/solutions/service-providers/",
      "permanent": true
    },
    {
      "source": "/ar/service-providers",
      "destination": "/ar/solutions/service-providers/",
      "permanent": true
    },
    {
      "source": "/ar/service-providers/",
      "destination": "/ar/solutions/service-providers/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/capabilities/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
